{
	# Используем production Let's Encrypt
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	
	# Уровень info, а не debug: отладка сертификатов давно закончилась, а логи
	# содержат адреса посетителей. Хранение ограничено и по объёму, и по сроку —
	# см. docs/anonymity-model.md, раздел «Операционные требования».
	log {
		level info
		output file /data/caddy.log {
			roll_size 5mb
			roll_keep 2
			roll_keep_for 168h
		}
	}
}

{
	# Optional: email for ACME account; can be set via env if needed
	# email {$ACME_EMAIL}
	# Enables automatic HTTPS, HTTP/2/3 by default
}

# Frontend host: serves static via frontend container
{$DOMAIN} {
  encode zstd gzip

  # Access-лог сайта читателя — единственный источник аналитики: счётчика на
  # странице нет и быть не может (просмотрщик не ходит в сеть). Лог включён
  # только здесь: на хосте API следы участников закрытого круга, и в аналитику
  # они не идут. Замысел — docs/analytics-plan-2026-08.md.
  #
  # Отсюда лог забирают двое: экспорт в Matomo (посещаемость) и счётчики
  # контента. Срок хранения самого файла короткий — в нём адреса посетителей.
  # `mode` обязателен: по умолчанию Caddy создаёт лог с правами 0600 от root,
  # а читает его контейнер API под uid 10001.
  log {
    output file /logs/access.log {
      roll_size 20mb
      roll_keep 5
      roll_keep_for 72h
      mode 0644
    }
    format json
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer-when-downgrade"
    # SAMEORIGIN, а не DENY: DENY запрещает кадрирование вообще, включая
    # собственные страницы, а рабочему месту (/work/) и опроснику (/survey/)
    # нужен предпросмотр страницы читателя в iframe. Чужим сайтам кадрирование
    # по-прежнему запрещено.
    X-Frame-Options "SAMEORIGIN"
    Content-Security-Policy "frame-ancestors 'self'"
    Permissions-Policy "geolocation=(), camera=(), microphone=()"
  }

  route {
    # Тестовый зонд: сохраняем полный путь
    handle /.hooks/probe {
      header {
        Cache-Control "no-store"
        X-Debug "hook-probe"
      }
      respond 418
    }

    # Основной вебхук: сохраняем полный путь (НЕ handle_path)
    handle /.hooks/redpen-publish {
      header {
        Cache-Control "no-store"
      }
      reverse_proxy content-sync:9000
    }

    # Любые другие /.hooks/* → 404 (без среза префикса)
    handle /.hooks/* {
      header {
        Cache-Control "no-store"
      }
      respond 404
    }

    # Всё остальное — фронтенд
    handle {
      reverse_proxy frontend:80
    }
  }
}
# Дашборд аналитики. Отдельный хост, потому что это единственная часть системы,
# у которой есть админка: держать её на хосте сайта значит подмешивать PHP к
# статике, которая обязана оставаться самодостаточной.
#
# Два замка, и внешний важнее внутреннего. `basic_auth` отсекает запрос до того,
# как он дойдёт до PHP: снаружи Matomo — это не только форма входа, но и ручка
# трекера, открытая всем желающим налить выдуманных визитов. Наш собственный
# импорт идёт по внутренней сети (`http://matomo/`) и пароля не видит.
#
# В базе за этой дверью лежат адреса читателей — см. docs/anonymity-model.md,
# раздел «Читатели сайта».
{$STATS_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		# Никакого реферера наружу: адреса отчётов рассказывают, что мы смотрим.
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		# Поисковикам тут делать нечего.
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	basic_auth {
		{$STATS_USER} {$STATS_PASSWORD_HASH}
	}

	reverse_proxy matomo:80
}

# API host: Caddy handles CORS
{$API_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer-when-downgrade"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
	}

	# Быстрый preflight с явными CORS заголовками
	@preflight {
		method OPTIONS
		path /api/*
	}
	handle @preflight {
		header Access-Control-Allow-Origin "https://{$DOMAIN}"
		header Access-Control-Allow-Credentials "true"
		# PATCH обязателен: узкие операции над замечанием
		# (.../status, .../category, .../tags) ходят именно им, а редактор живёт
		# на другом источнике, чем API, — без метода в этом списке браузер
		# зарубит их на предполётном запросе.
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		# X-Survey-Token обязателен по той же причине, что и PATCH выше: опросник
		# (/survey/) опознаёт респондента этим заголовком вместо куки, живёт на
		# другом источнике, чем API, и без заголовка в этом списке браузер рубит
		# предполётный запрос — опрос молча сообщает «нет связи с сервером».
		header Access-Control-Allow-Headers "Content-Type, Authorization, X-CSRF-Token, X-Survey-Token"
		header Access-Control-Max-Age "86400"
		respond 204
	}

	# Предел на размер тела запроса. Без него один гигабайтный POST на открытую
	# ручку входа дороже тысячи мелких: FastAPI читает тело в память целиком, а
	# ограничение частоты считает такой запрос за один. Аннотации — это текст,
	# двух мегабайт с запасом хватает.
	request_body {
		max_size 2MB
	}

	# Проксирование всех остальных /api/* в бекенд
	reverse_proxy api:8080 {
		# Убедимся, что заголовки добавляются и к обычным ответам
		header_up Access-Control-Allow-Origin "https://{$DOMAIN}"
		header_up Access-Control-Allow-Credentials "true"
		# Перезапись, а не добавление. По умолчанию Caddy дописывает адрес
		# соединения в конец пришедшего X-Forwarded-For, оставляя в начале то,
		# что прислал клиент. Ограничение частоты в API считает по этому
		# заголовку, поэтому клиентская часть значения — это возможность
		# назначать себе ключ ведра и не встречать предела вовсе. Здесь
		# заголовок собирается заново из одного адреса соединения.
		header_up X-Forwarded-For "{http.request.remote.host}"
	}
}
