/.env.secrets
/redpen-content/
/redpen-publish/

# Соседние репозитории и секреты — выше; ниже то, что порождают инструменты.

# Питоновское окружение и байткод. .venv держит в том числе playwright для
# браузерных тестов (tests/requirements.txt) — это сотни мегабайт.
.venv/
__pycache__/
*.pyc

# В проекте нет ни сборщика, ни JS-зависимостей: templates/js/*.js
# подключаются тегами <script>, а проверка — node --check, которому ничего
# ставить не нужно. Строка стоит как страховка: однажды npm install в корне
# уже оставил здесь 17 МБ чужих пакетов.
node_modules/

# Рабочий каталог сборок: бэкапы publish-дерева (build_website.py) и
# офлайн-архивы (make_offline_bundle.py) — сотни мегабайт, месту в git не подлежат.
/tmp/

# macOS
.DS_Store
