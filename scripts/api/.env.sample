# Example environment for RedPen API
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# Agent token login: "token1:agentname1,token2:agentname2". Это вход для
# агентов: их правки помечаются прогоном (agent_runs). Пусто -> вход по токену
# выключен. Реальные значения в git не коммитить.
# AGENT_TOKENS — новое имя; EDITOR_TOKENS читается для совместимости.
AGENT_TOKENS=

# SQLite DB for users/sessions/invites. Keep this outside
# PUBLISH_DIR — that path is the mounted redpen-publish working copy.
DB_PATH=/var/redpen-db/redpen.db

# Google Identity Services OAuth client id. Empty -> /api/auth/google
# responds 503. This value is public (ships in the static frontend too).
GOOGLE_CLIENT_ID=

# Перец для хеширования Google `sub`. ОБЯЗАТЕЛЕН: без него вход через Google
# отвечает 503. Должен лежать только в .env.secrets на сервере и никогда не
# попадать ни в git, ни в БД, ни в её бэкап — иначе теряется весь смысл
# (docs/anonymity-model.md). Сгенерировать: openssl rand -hex 32
IDENTITY_PEPPER=

# Одноразовый код, дающий роль admin первому вошедшему на пустой базе.
# Пока в системе есть хоть один админ, переменная не делает ничего.
# Заменил ADMIN_EMAILS: тот хранил именной список в окружении прода.
BOOTSTRAP_INVITE_CODE=

# Secure flag on the session cookie. Set to false only for local http dev.
COOKIE_SECURE=true

# Directory the publisher writes rendered annotations/page_NNN.json
# snapshots into (stage 2). Empty/missing -> publication disabled (the
# default; fine for local dev without the redpen_public volume mounted).
# In docker-compose.yml this is set to /srv/public (the shared volume nginx
# serves from).
PUBLISH_DIR=
