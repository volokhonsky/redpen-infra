# Example environment for RedPen API
STORAGE_DIR=/data
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# Editor personal-token login: "token1:username1,token2:username2".
# Empty/missing -> token login disabled. Never commit real values.
EDITOR_TOKENS=

# SQLite DB for users/sessions/allowlist (stage 1). Keep this outside
# STORAGE_DIR — that path is the mounted redpen-publish working copy.
DB_PATH=/var/redpen-db/redpen.db

# Google Identity Services OAuth client id. Empty -> /api/auth/google
# responds 503. This value is public (ships in the static frontend too).
GOOGLE_CLIENT_ID=

# Emails granted the admin role unconditionally, comma-separated.
ADMIN_EMAILS=

# Secure flag on the session cookie. Set to false only for local http dev.
COOKIE_SECURE=true
