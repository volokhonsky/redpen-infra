# Unified environment configuration for domains/URLs
# Adjust values on the VPS before running `docker compose up -d`
DOMAIN=medinsky.net
API_SUBDOMAIN=api
API_HOST="${API_SUBDOMAIN}.${DOMAIN}"
FRONTEND_ORIGIN="https://${DOMAIN}"
API_BASE_URL="https://${API_HOST}"

# API service runtime
STORAGE_DIR=/var/redpen-data
LOG_LEVEL=info
# CORS allow origins for API, use FRONTEND_ORIGIN by default
CORS_ALLOW_ORIGINS=https://medinsky.net

# Auth (stage 1) — secrets/deployment-specific, set real values in the
# server's .env or .env.secrets (never commit real tokens/ids here).
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=
EDITOR_TOKENS=

# Content sync configuration
CONTENT_GIT_REPO=git@github.com:volokhonsky/redpen-publish.git
CONTENT_GIT_REF=main